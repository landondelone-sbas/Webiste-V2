# ══════════════════════════════════════════════════════════════
# SBAS Info LLC — backend environment
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env          (macOS / Linux)
#     copy .env.example .env        (Windows CMD)
#
# `.env` is git-ignored. This file (`.env.example`) is committed,
# and must NEVER contain a real key — it is the template only.
# ══════════════════════════════════════════════════════════════

# Stripe SECRET key. Dashboard → Developers → API keys.
# Starts with sk_test_ while testing, sk_live_ in production.
# This value is the keys to the bank. It belongs only here,
# never in an HTML file, never in a commit, never in a screenshot.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret. Two ways to get it:
#   Local:      stripe listen --forward-to localhost:4242/api/webhook
#   Production: Dashboard → Developers → Webhooks → your endpoint
# Without this, server.js cannot verify that a webhook genuinely
# came from Stripe — anyone could POST a fake "payment succeeded".
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Where the static site is served from. Used for two things:
#   1. CORS — only this origin may call the API
#   2. The return_url Stripe sends the customer back to after paying
# No trailing slash. Must match your live domain in production.
SITE_URL=http://localhost:5500

# Port the API listens on. Must match API_BASE in payment.html.
PORT=4242
